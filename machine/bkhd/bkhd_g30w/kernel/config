# g30w kernel fragment, merged over conf/kernel/<release>/linux.x86_64.config
#
# The base config already provides NVMe (BLK_DEV_NVME), SATA/AHCI,
# IGB, USB storage and 8250 serial support.  The Intel I226 controllers
# need the igc driver, which is not enabled in the ONIE base config.
CONFIG_IGC=y

# Required built-in for NVMe boot, independent of base config defaults.
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# Use the UEFI GOP framebuffer for the local installation console.
# Avoid experimental EHL i915 modesetting on this kernel; boot in UEFI
# mode so firmware supplies the framebuffer. No GPU acceleration needed.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB=y
CONFIG_FB_EFI=y
# CONFIG_DRM is not set
# CONFIG_DRM_I915 is not set
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y

# USB keyboard for the local ONIE shell.
CONFIG_INPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
